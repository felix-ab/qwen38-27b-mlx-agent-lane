+    @staticmethod
+    def _checkpoint_metadata(path):
+        """Read only the safetensors header; scanning other chats allocates no tensors."""
+        with open(path, "rb") as handle:
+            header = handle.read(8)
+            if len(header) != 8:
+                raise ValueError("truncated checkpoint header")
+            n = struct.unpack("<Q", header)[0]
+            if n > 16 * 1024 * 1024:
+                raise ValueError("checkpoint header exceeds 16 MiB")
+            return json.loads(handle.read(n)).get("__metadata__", {})
 
+    def _usable_checkpoint(self, tokens, rungs, prompt_ids):
+        lcp = _lcp(tokens, prompt_ids)
+        if lcp >= len(tokens) and len(prompt_ids) > len(tokens):
+            return len(tokens)
+        return max((r for r in rungs if self.min_reuse <= r <= lcp and r < len(prompt_ids)), default=0)
+
+    def _promote_disk_match(self, prompt_ids):
+        """Replace one resident checkpoint only when disk avoids >=256 prefill tokens."""
+        resident = {s.sid for s in self._slots}
+        best_len = max((self._usable_checkpoint(s.tokens, s.rungs, prompt_ids)
+                        for s in self._slots if s.snapshot is not None), default=0)
+        # Synchronize with atomic publication/pruning. This also prevents reloading an
+        # incomplete snapshot or pruning the selected file while it is materialized.
+        with self._persist_lock:
+            best_path, disk_len = None, best_len
+            for path in self._persisted_files():
+                sid = int(os.path.basename(path)[len("ckpt_"):-len(".safetensors")])
+                if sid in resident:
+                    continue
+                try:
+                    meta = self._checkpoint_metadata(path)
+                    if meta.get("version") != "1":
+                        continue
+                    reuse = self._usable_checkpoint(json.loads(meta["tokens"]),
+                                                    map(int, json.loads(meta.get("rungs", "{}"))), prompt_ids)
+                    if reuse > disk_len and reuse - best_len >= 256:
+                        best_path, disk_len = path, reuse
+                except (OSError, ValueError, KeyError, TypeError):
+                    continue
+            if best_path is None:
+                return
+            # Release an old slot before loading: the disk LRU must not become extra
+            # resident snapshots on this 48 GB machine. A failed restore cold-prefills.
+            if len(self._slots) >= self.max_slots:
+                self._slots.pop()
+            self._load_persisted(only=[best_path])
+            if any(self._ckpt_path(s.sid) == best_path for s in self._slots):
+                self.disk_hits += 1
+                with contextlib.suppress(OSError):
+                    os.utime(best_path, None)
+
