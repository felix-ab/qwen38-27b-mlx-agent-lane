+    # -- persisted checkpoint slots (local patch) --
+    def _ckpt_path(self, sid: int) -> str:
+        return os.path.join(self.l2_dir, f"ckpt_{sid}.safetensors")
+
+    def _remove_ckpt_file(self, sid: int) -> None:
+        if self.l2_dir:
+            with contextlib.suppress(OSError):
+                os.remove(self._ckpt_path(sid))
+
+    @staticmethod
+    def _meta_json(meta):
+        try:
+            json.dumps(meta)
+            return meta
+        except TypeError:
+            return None
+
+    def _persist_checkpoint(self, slot: _Slot) -> None:
+        """Serialize a checkpoint slot (boundary snapshot + rungs) to ``l2_dir``. Runs in a
+        background thread; the snapshot arrays are already materialized copies."""
+        try:
+            with self._persist_lock:
+                snap, snap_ctx = slot.snapshot
+                arrays, layers = {}, []
+                for i, (state, meta) in enumerate(snap):
+                    items = list(state) if isinstance(state, (list, tuple)) else [state]
+                    kinds = []
+                    for j, a in enumerate(items):
+                        if isinstance(a, mx.array):
+                            arrays[f"l{i}_s{j}"] = a
+                            kinds.append("a")
+                        else:
+                            kinds.append("n")
+                    layers.append({"n": len(items), "kinds": kinds,
+                                   "tuple": isinstance(state, tuple), "meta": self._meta_json(meta)})
+                rungs = {}
+                for pos, cap in slot.rungs.items():
+                    entries = []
+                    for (i, st, meta) in cap:
+                        items = list(st) if isinstance(st, (list, tuple)) else [st]
+                        kinds = []
+                        for j, a in enumerate(items):
+                            if isinstance(a, mx.array):
+                                arrays[f"r{pos}_l{i}_s{j}"] = a
+                                kinds.append("a")
+                            else:
+                                kinds.append("n")
+                        entries.append({"i": i, "n": len(items), "kinds": kinds,
+                                        "tuple": isinstance(st, tuple), "meta": self._meta_json(meta)})
+                    rungs[str(pos)] = entries
+                ctx_n = 0
+                if snap_ctx:
+                    for i, (k, v) in enumerate(snap_ctx):
+                        arrays[f"c{i}_k"], arrays[f"c{i}_v"] = k, v
+                    ctx_n = len(snap_ctx)
+                meta = {"version": "1", "tokens": json.dumps(slot.tokens), "layers": json.dumps(layers),
+                        "rungs": json.dumps(rungs), "nontrim": json.dumps(slot.nontrim), "ctx_n": str(ctx_n)}
+                # NOTE: no `mx.stream(mx.cpu)` here — MLX's default stream is process-global,
+                # so a stream context in this thread would schedule every op the serving
+                # thread builds meanwhile onto the CPU (measured: a 27B 6-bit matmul stall of
+                # minutes). The snapshot arrays are already materialized; this is pure I/O.
+                # save_safetensors appends ".safetensors" to names lacking it, so the temp
+                # name must already end with it and must not match the ckpt_* load glob.
+                t0 = time.perf_counter()
+                tmp = self._tmp_path(slot.sid)
+                mx.save_safetensors(tmp, arrays, meta)
+                os.replace(tmp, self._ckpt_path(slot.sid))
+                size = os.path.getsize(self._ckpt_path(slot.sid))
+                for sid in getattr(slot, "superseded", ()):
+                    self._remove_ckpt_file(sid)      # only now: a kill mid-write keeps the older file
+                self._prune_ckpt_files()
+                print(f"[prefix-cache] persisted checkpoint slot {slot.sid} ({len(slot.tokens)} tokens, "
+                      f"{size / 1e9:.2f} GB) in {time.perf_counter() - t0:.1f}s", flush=True)
+        except Exception as e:  # never let persistence break serving
+            with contextlib.suppress(OSError):
+                os.remove(self._tmp_path(slot.sid))
+            print(f"[prefix-cache] checkpoint persist failed for slot {slot.sid}: {e!r}", flush=True)
 
+    def _prune_ckpt_files(self) -> None:
+        """Delete checkpoint files of slots that are no longer held (evicted/superseded while a
+        shed or reset had detached them), bounding disk use to the live slots."""
+        live = {s.sid for s in self._slots}
+        for s in self._slots:                    # files a live slot's pending persist still replaces
+            live.update(getattr(s, "superseded", ()))
+        for path in glob.glob(os.path.join(self.l2_dir, "ckpt_*.safetensors")):
+            m = re.fullmatch(r"ckpt_(\d+)\.safetensors", os.path.basename(path))
+            if m and int(m.group(1)) not in live:
+                with contextlib.suppress(OSError):
+                    os.remove(path)
+
+    def _tmp_path(self, sid: int) -> str:
+        return os.path.join(self.l2_dir, f"tmp-ckpt_{sid}.safetensors")
+
+    def _persisted_files(self) -> list[str]:
+        for stale in glob.glob(os.path.join(self.l2_dir, "tmp-ckpt_*.safetensors")):
+            with contextlib.suppress(OSError):
+                os.remove(stale)                     # an interrupted write
+        return sorted((p for p in glob.glob(os.path.join(self.l2_dir, "ckpt_*.safetensors"))
+                       if re.fullmatch(r"ckpt_\d+\.safetensors", os.path.basename(p))),
+                      key=os.path.getmtime, reverse=True)
+
+    def _load_best_persisted(self, prompt_ids: list[int]) -> None:
+        """Materialize the one persisted slot with the longest usable common prefix for
+        ``prompt_ids`` (metadata scan only for the others). No-op when nothing matches."""
+        best, best_len = None, 0
+        for path in self._persisted_files():
+            try:
+                _, meta = mx.load(path, return_metadata=True)
+                if meta.get("version") != "1":
+                    continue
+                tokens = json.loads(meta["tokens"])
+                lcp = _lcp(tokens, prompt_ids)
+                rungs = [int(r) for r in json.loads(meta.get("rungs", "{}"))]
+                usable = (len(tokens) if lcp >= len(tokens) and len(prompt_ids) > len(tokens)
+                          else max((r for r in rungs if self.min_reuse <= r <= lcp), default=0))
+                if usable > best_len:
+                    best, best_len = path, usable
+            except Exception as e:
+                print(f"[prefix-cache] could not read persisted checkpoint {path}: {e!r}", flush=True)
+        if best is not None and best_len >= self.min_reuse:
+            self._load_persisted(only=[best])
+
+    def _load_persisted(self, only: list[str] | None = None) -> None:
+        """Rebuild checkpoint slots from ``l2_dir`` (lazy, file-backed arrays: no RAM until a
+        hit copies them). Newest files first; anything beyond ``max_slots`` is deleted."""
+        paths = self._persisted_files() if only is None else list(only)
+        loaded = len(self._slots) if only is not None else 0
+        for path in paths:
+            if loaded >= self.max_slots:
+                if only is None:
+                    with contextlib.suppress(OSError):
+                        os.remove(path)
+                continue
+            if any(s.sid == int(os.path.basename(path)[len("ckpt_"):-len(".safetensors")])
+                   for s in self._slots):
+                continue                             # already attached
+            try:
+                sid = int(os.path.basename(path)[len("ckpt_"):-len(".safetensors")])
+                arrays, meta = mx.load(path, return_metadata=True)
+                if meta.get("version") != "1":
+                    continue
+                # Materialize now: MLX 0.32 binds lazy ops (incl. file loads) to the creating
+                # thread's streams ("There is no Stream(cpu, N) in current thread" when another
+                # thread evaluates them). Evaluated arrays are usable from any request thread,
+                # and steady state holds these slots in RAM anyway (2-3 GB per 30k-token slot).
+                mx.eval(list(arrays.values()))
+                tokens = json.loads(meta["tokens"])
+                layers = json.loads(meta["layers"])
+                snap = []
+                for i, lm in enumerate(layers):
+                    items = [arrays.get(f"l{i}_s{j}") if k == "a" else None for j, k in enumerate(lm["kinds"])]
+                    state = tuple(items) if lm["tuple"] else items
+                    snap.append((state, lm.get("meta")))
+                rungs = {}
+                for pos, entries in json.loads(meta.get("rungs", "{}")).items():
+                    cap = []
+                    for e in entries:
+                        items = [arrays.get(f"r{pos}_l{e['i']}_s{j}") if k == "a" else None
+                                 for j, k in enumerate(e["kinds"])]
+                        st = tuple(items) if e["tuple"] else items
+                        cap.append((e["i"], st, e.get("meta")))
+                    rungs[int(pos)] = cap
+                ctx_n = int(meta.get("ctx_n", "0") or 0)
+                snap_ctx = [(arrays[f"c{i}_k"], arrays[f"c{i}_v"]) for i in range(ctx_n)] or None
+                slot = _Slot(tokens, None, None, sid, snapshot=(snap, snap_ctx), rungs=rungs,
+                             nontrim=json.loads(meta.get("nontrim", "[]")))
+                self._slots.append(slot)
+                self._next_sid = max(self._next_sid, sid + 1)
+                loaded += 1
+            except Exception as e:
+                print(f"[prefix-cache] could not load persisted checkpoint {path}: {e!r}", flush=True)
+        if loaded:
+            print(f"[prefix-cache] restored {loaded} persisted checkpoint slot(s) from {self.l2_dir} "
+                  f"(tokens: {[len(s.tokens) for s in self._slots]})", flush=True)
+
